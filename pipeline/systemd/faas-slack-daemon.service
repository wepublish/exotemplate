# systemd-User-Service-Vorlage fuer den FaaS-Slack-Socket-Mode-Daemon.
#
# Der Controller installiert + passt Pfade an (separates venv mit slack_sdk).
# Installation (auf dem Spark, als User dergeraet):
#   cp spark/faas-slack-daemon.service ~/.config/systemd/user/faas-slack-daemon.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now faas-slack-daemon.service
#   (Linger ist auf dem Spark bereits aktiv -> reboot-fest)
#
# Das Skript liest ~/.hermes/.env (SLACK_APP_TOKEN, DIRECTUS_TOKEN) und
# ~/.hermes/config.yaml (xoxb) selbst -> keine EnvironmentFile noetig.

[Unit]
Description=FaaS Slack Socket-Mode Daemon (Roadmap-Pult)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dergeraet/faas-matching-wepublish/spark
ExecStart=/home/dergeraet/faas-slack-daemon-venv/bin/python /home/dergeraet/faas-matching-wepublish/spark/faas_slack_daemon.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
