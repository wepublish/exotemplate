[Unit]
Description=FaaS Directus forwarder (Spark 127.0.0.1:8055 -> VPS Directus 100.120.78.79:8055 over Tailscale, B9 interim write path)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/dergeraet/faas_directus_forward.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
