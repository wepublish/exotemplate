# =============================================================================
# .env.example – FaaS self-contained (Hetzner-VPS)
#
# Kopieren und mit echten Werten fuellen:   cp .env.example .env
# .env NIEMALS committen. Nur diese Vorlage (.env.example) liegt im Repo.
#
# NIEMALS echte Secrets in diese Vorlage schreiben – nur Platzhalter.
# Neue Zufalls-Secrets erzeugen:            openssl rand -hex 32
# KEY/SECRET/DB_PASSWORD/Tokens fuer die MIGRATION dagegen 1:1 aus dem
# bestehenden Spark-Setup uebernehmen (siehe Hinweise unten), NICHT neu wuerfeln.
# =============================================================================

############################################################
## POSTGRES + DIRECTUS – Datenbank
############################################################

# Postgres-Passwort. MUSS identisch sein mit dem Directus-DB_PASSWORD (unten
# ist es dieselbe Variable). Bei der Migration: exakt den Wert aus dem
# Spark-Setup uebernehmen, sonst startet Directus nicht gegen die restaurierte DB.
DB_PASSWORD=__db_passwort__

############################################################
## DIRECTUS – Sicherheit (KRITISCH: 1:1 aus dem Altsystem!)
############################################################

# KEY und SECRET MUESSEN identisch aus dem Spark-Setup uebernommen werden
# (liegen dort in docker-compose.yml/.env unter
#  /home/dergeraet/wepublish/faas/stiftungsdatenbank/).
# NICHT neu generieren: sonst werden alle verschluesselten Felder und
# bestehenden Sessions nach der Migration unbrauchbar. Kritischster Punkt.
KEY=__key_aus_altsystem_uebernehmen__
SECRET=__secret_aus_altsystem_uebernehmen__

############################################################
## DIRECTUS – Admin (Bootstrap)
############################################################

ADMIN_EMAIL=admin@wepublish.ch
ADMIN_PASSWORD=__admin_passwort__

############################################################
## DIRECTUS – oeffentliche URL / Payload
############################################################

# Neu fuer die VPS bestimmen. Altsystem hatte KEINE PUBLIC_URL (Zugang lief
# ueber Cloudflare-Tunnel). Setzen, sobald Domain/Reverse-Proxy feststeht,
# z.B. https://matching.winkelriedtoechter.ch . Vorlaeufig "/" (relativ).
PUBLIC_URL=/

# Max Request-Body (Contract-PDFs base64 im JSON, ~33% groesser).
MAX_PAYLOAD_SIZE=15mb

# Frontend-URLs der VPS fuer Invite-/Reset-Mail-Links (Directus honoriert nur
# Allow-List-URLs). Beispiel-Muster – an echte Domain anpassen:
# PASSWORD_RESET_URL_ALLOW_LIST=https://matching.winkelriedtoechter.ch/auth/set-new-password
# USER_INVITE_URL_ALLOW_LIST=https://matching.winkelriedtoechter.ch/auth/accept-invite
PASSWORD_RESET_URL_ALLOW_LIST=
USER_INVITE_URL_ALLOW_LIST=
USER_INVITE_TOKEN_TTL=14d

############################################################
## E-MAIL-VERSAND (Gmail/SMTP) – externe Anbindung
############################################################
# Bleibt externe Anbindung (kein Container). Werte aus dem bestehenden Setup.
# Fuer Gmail: App-Passwort verwenden (kein Kontopasswort). Leer lassen = kein
# Versand (Directus laeuft trotzdem).
EMAIL_FROM=no-reply@t.wepublish.email
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=__smtp_app_passwort__
EMAIL_SMTP_SECURE=false

############################################################
## FRONT (Next.js) – Pflicht
############################################################

# DIRECTUS_URL wird im Compose HART auf http://directus:8055 gesetzt
# (Compose-internes Netz) und muss hier NICHT gepflegt werden.

# Directus-Service-Token (server-seitig, nie im Browser-Bundle). Bei Migration
# aus dem Altsystem uebernehmen oder in Directus neu erzeugen und hier eintragen.
# Fehlt/leer => App laeuft an, liefert aber ueberall 401/403 (stiller Ausfall).
DIRECTUS_TOKEN=__directus_service_token__

# Signiergeheimnis fuer den Magic-Link-Login des Medienportals. Fehlt =>
# alle /api/portal/*-Routen antworten 503. Neu erzeugen: openssl rand -hex 32
PORTAL_SESSION_SECRET=__portal_session_secret__

# Basis-URL fuer die Login-Links im Portal, z.B.
# https://matching.winkelriedtoechter.ch . Leer = relativer Link (nur ok, wenn
# Portal und App denselben Origin teilen).
PORTAL_BASE_URL=

############################################################
## FRONT – LLM (Claude/Anthropic)
############################################################

# Pflicht fuer alle LLM-Funktionen (DNA-Messung, Gesuch-Vorbau, Betrag-
# Recherche, Kontakt-Mails). Wird vom @anthropic-ai/sdk automatisch aus der
# Umgebung gelesen. Ohne Key werfen LLM-Calls erst zur Nutzungszeit.
ANTHROPIC_API_KEY=__anthropic_api_key__
# Modell (optional). Code-Default: claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

############################################################
## FRONT – optionale Anbindungen (degradieren sauber)
############################################################

# Firecrawl-kompatibler Crawler. INTERIM: Spark-Crawler ueber Tailscale.
# (Spark-Crawler ist bereits unter der Tailscale-IP :8891 exponiert.)
# Alternative laut RUNBOOK: eigener Crawler-Container auf der VPS.
FIRECRAWL_URL=http://100.80.47.49:8891

# Hermes-Adapter ("Der Gerät", Assistenten-Chat) – laeuft auf dem Spark, via
# Tailscale. Leer => betroffene Routen no-op/inaktiv.
HERMES_API_URL=
# Optionaler Bearer fuer den Hermes-Adapter (aktuell ungenutzt).
HERMES_API_KEY=

# Assistenten-Chat/Agent-Routen freischalten. Muss exakt 'true' sein.
FAAS_AGENT_ENABLED=

# Anzahl Treffer in der kuratierten Portal-Minimalansicht (Top-N). Default 20.
PORTAL_TREFFER_LIMIT=20

# Basis-Pfad des read-only rclone-Drive-Mounts (Datensuppe). Nur setzen, wenn
# der optionale rclone-Service im Compose aktiviert ist. Default im Code:
# /datensuppe. Ohne Mount warnt Ein-Knopf-DNA sichtbar und laesst die Quelle aus.
DATENSUPPE_BASE=

############################################################
## EXTERN / INFRASTRUKTUR (kein Container in diesem Compose)
############################################################

# Slack-Webhook: externe Anbindung, wird von der Anreicherungs-/Matching-
# Pipeline (interim auf dem Spark) genutzt, nicht von den Containern hier.
# Nur als Platzhalter dokumentiert; auf dem Spark/Secret-Store fuehren.
# SLACK_WEBHOOK_URL=__slack_incoming_webhook__

# Cloudflare-Tunnel: falls cloudflared auf der VPS laeuft, denselben
# TUNNEL_TOKEN wie auf dem Spark wiederverwenden (gleiche Tunnel-ID => keine
# DNS-/Access-Aenderung noetig). Als Secret fuehren, nicht committen.
# TUNNEL_TOKEN=__cloudflared_tunnel_token_aus_altsystem__
