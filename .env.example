# Configuration for the Docker stack (docker-compose.yml at the repo root).
#
#   cp .env.example .env
#
# The values below run the stack locally as-is. Everything marked CHANGE must get a
# real value before this reaches a server.
#
# Local development without Docker reads apps/directus/.env and
# apps/front/.env.local instead — see the README.
#
# Not everything about a deployment lives here: the SERVICE NAMES in
# docker-compose.yml still carry the `appname-` placeholder and must be renamed per
# project, because they have to be unique across the whole deploy host. The compose
# file explains what happens if two stacks share one.

####################################################################################
## Claude API — the only language model in this stack.
## No key: the app runs, AI features return an error. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

####################################################################################
## Directus admin, created on first boot of an empty database.
## CHANGE both before deploying. Every project cloned from this template ships the
## line below unchanged, so two deployments that keep it accept each other's login —
## which is how a request that reached the wrong instance still looked authenticated.
ADMIN_EMAIL=admin@wepublish.ch
ADMIN_PASSWORD=admin123

####################################################################################
## Secrets — CHANGE both before deploying, and use a fresh pair per deployment:
##
##   printf 'KEY=%s\nSECRET=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)"
##
## SECRET signs the access tokens. Two deployments that share it silently accept each
## other's tokens; two that differ reject them with `403 INVALID_TOKEN`. Neither is
## the failure you want to debug — keep them distinct and keep the hostnames distinct.
KEY=59ccea19-23112-4a08-8sw72-dd2312341412
SECRET=1234

####################################################################################
## Database — CHANGE the password before deploying
DB_DATABASE=directus
DB_USER=postgres
DB_PASSWORD=password

####################################################################################
## Public URLs. Behind a reverse proxy, set these to the real https:// addresses —
## Directus uses them for CORS, for the invite/reset link allow-lists and for the
## links in its own emails.
DIRECTUS_PUBLIC_URL=http://localhost:8055
FRONT_PUBLIC_URL=http://localhost:3000

####################################################################################
## Host ports. Change if 3000/8055 are already taken.
FRONT_PORT=3000
DIRECTUS_PORT=8055

####################################################################################
## Timezone for scheduled Flows (cron triggers fire in this zone).
TZ=Europe/Zurich

####################################################################################
## Set to false to boot without applying apps/directus/schema on start.
RUN_SCHEMA_SYNC=true
