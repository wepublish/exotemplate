{
  "name": "wepublish",
  "description": "Please enter a description for your extension",
  "icon": "extension",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "aggregatedHours",
        "source": "src/aggregatedHours/index.ts"
      },
      {
        "type": "endpoint",
        "name": "networkContribution",
        "source": "src/networkContribution/index.ts"
      },
      {
        "type": "endpoint",
        "name": "invoice-with-topup",
        "source": "src/invoice-with-topup/index.ts"
      },
      {
        "type": "endpoint",
        "name": "client-onboarding",
        "source": "src/client-onboarding/index.ts"
      },
      {
        "type": "endpoint",
        "name": "time-tracking",
        "source": "src/time-tracking/index.ts"
      },
      {
        "type": "operation",
        "name": "daily-capture-reminder",
        "source": {
          "app": "src/daily-capture-reminder/app.ts",
          "api": "src/daily-capture-reminder/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "peering-articles",
        "source": {
          "app": "src/peering-articles/app.ts",
          "api": "src/peering-articles/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "jira-threshold-notifier",
        "source": {
          "app": "src/jira-threshold-notifier/app.ts",
          "api": "src/jira-threshold-notifier/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "weekly-report",
        "source": {
          "app": "src/weekly-report/app.ts",
          "api": "src/weekly-report/api.ts"
        }
      },
      {
        "type": "hook",
        "name": "jira-halt-notifier",
        "source": "src/jira-halt-notifier/index.ts"
      }
    ],
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "add": "directus-extension add",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.0.11",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "vue": "^3.5.30"
  }
}
