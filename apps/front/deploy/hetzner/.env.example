# Hetzner-Deploy-Env-Vorlage. Kopieren nach `.env` (gleicher Ordner,
# neben docker-compose.yml) und mit echten Werten füllen. `.env` selbst
# NIE committen (Secrets).
#
# Phase 1: nur die App läuft auf Hetzner. Directus, vLLM (LLM), der Crawler
# und der Hermes-Adapter bleiben auf dem Spark und werden über Tailscale
# erreicht - darum die Beispieladressen `100.x.y.z` (Tailscale-IP des Spark,
# siehe README.md für die Erreichbarkeits-Checkliste).

# ── Pflicht (ohne diese vier antwortet die App mit 503/403 bzw. warnt beim
#    ersten API-Aufruf einmalig in den Logs, siehe src/lib/env-check.ts) ──

# Directus-GraphQL-Endpunkt auf dem Spark, über Tailscale erreichbar.
DIRECTUS_URL=http://100.x.y.z:8055
# Directus-Service-Token. Bleibt server-seitig (Proxy src/pages/api/directus.ts),
# gelangt nie ins Browser-Bundle.
DIRECTUS_TOKEN=__hier_directus_token__

# Medien-Selbstbedienungsportal (Magic-Link-Login). Langes, zufälliges
# Geheimnis (z.B. `openssl rand -hex 32`). Ohne dieses Secret antworten alle
# /api/portal/*-Routen mit 503 "Portal nicht konfiguriert".
PORTAL_SESSION_SECRET=__hier_langes_zufaelliges_geheimnis__
# Basis-URL, unter der die App öffentlich erreichbar ist (für Login-Links
# im Portal). Z.B. https://matching.winkelriedtoechter.ch
PORTAL_BASE_URL=https://matching.winkelriedtoechter.ch

# ── Optional (LLM-Features und Nebenfunktionen degradieren sauber, wenn
#    diese fehlen bzw. leer bleiben) ──

# vLLM-Endpunkt auf dem Spark (Betrag-Recherche, DNA-Messung, Gesuch-Vorbau).
# Über Tailscale erreichbar, Default im Code ist http://127.0.0.1:8001.
LLM_URL=http://100.x.y.z:8001
# Modellname, den der vLLM-Server unter LLM_URL bedient.
LLM_MODEL=qwen3.6-27b

# Fallback-LLM (z.B. Studio-MLX-Server), falls LLM_URL nicht erreichbar ist.
# Optional, nur bei Bedarf setzen.
LLM_URL_FALLBACK=
LLM_MODEL_FALLBACK=

# Firecrawl-kompatibler Web-Crawler auf dem Spark (Ein-Knopf-DNA-Generierung,
# Betrag-Recherche). Über Tailscale erreichbar.
FIRECRAWL_URL=http://100.x.y.z:8891

# Hermes-Adapter ("Der Gerät", faas_chat_adapter.py) auf dem Spark. Steuert
# den Assistenten-Chat in der App. Über Tailscale erreichbar.
HERMES_API_URL=http://100.x.y.z:9200
# Optionaler API-Schlüssel, falls der Adapter einen verlangt (aktuell
# ungenutzt, Adapter läuft ohne Auth im Tailnet).
HERMES_API_KEY=
# Schaltet den Assistenten-Chat in der App frei. Leer/false = Chat zeigt
# "inaktiv". Auf "true" setzen, sobald HERMES_API_URL erreichbar ist.
FAAS_AGENT_ENABLED=false

# Anzahl Treffer, die das Medien-Portal in der kuratierten Minimal-Ansicht
# zeigt (Top-N, keine Scores/DNA-Interna). Default im Code ist 20.
PORTAL_TREFFER_LIMIT=20

# Basis-Pfad des read-only rclone-Mounts der geteilten Drive-Ablage
# (Remote `gdrive-faas:`, siehe README.md). Nur setzen, wenn der optionale
# rclone-Mount-Container in docker-compose.yml aktiviert ist. Leer lassen,
# wenn kein Mount vorhanden ist (Ein-Knopf-DNA-Generierung warnt dann
# sichtbar und lässt die Datensuppe-Quelle aus).
DATENSUPPE_BASE=
