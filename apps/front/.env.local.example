# Server-seitig — Token bleibt auf dem Server (via /api/directus-Proxy), nie im Browser-Bundle.
# Lokale Entwicklung (Studio): DIRECTUS_URL=http://100.80.47.49:8055 (Tailscale)
# Spark-Container (Directus lokal): DIRECTUS_URL=http://localhost:8055
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=__hier_token__

# Medien-Selbstbedienungsportal (Magic-Link-Login). Pflicht, sonst antworten
# alle /api/portal/*-Routen mit 503 "Portal nicht konfiguriert".
PORTAL_SESSION_SECRET=__hier_langes_zufaelliges_geheimnis__
# Basis-URL für den Login-Link (z.B. https://matching.winkelriedtoechter.ch).
# Leer lassen für einen relativen Link (nur sinnvoll, wenn Portal und App
# denselben Origin teilen).
PORTAL_BASE_URL=

# Claude-API (ersetzt den früheren lokalen vLLM/LLM_URL). Vom SDK automatisch
# gelesen; bleibt server-seitig, nie im Browser-Bundle. Pflicht für alle
# LLM-Funktionen (DNA-Messung, Gesuch-Vorbau, Betrag-Recherche, Kontakt-Mails).
ANTHROPIC_API_KEY=__hier_anthropic_key__
# Modell (optional). Default im Code: claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8
